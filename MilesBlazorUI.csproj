<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<Version>1.1.1</Version>
	<Title>Miles Blazor UI</Title>
	<Authors>Fan Xing Hua - Miles</Authors>
	<Description>Some simple UI components.</Description>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageProjectUrl>https://github.com/MilesFan/MilesBlazorUI</PackageProjectUrl>
	<RepositoryUrl>https://github.com/MilesFan/MilesBlazorUI</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
	<None Include="README.md" Pack="true" PackagePath="\" />
    <Compile Remove="bin\**" />
    <Compile Remove="Demo\**" />
    <Content Remove="bin\**" />
    <Content Remove="Demo\**" />
    <EmbeddedResource Remove="bin\**" />
    <EmbeddedResource Remove="Demo\**" />
    <None Remove="bin\**" />
    <None Remove="Demo\**" />
  </ItemGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
  	<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.12" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net9.0' ">
  	<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.1" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
  	<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.1" />
  </ItemGroup>
</Project>
